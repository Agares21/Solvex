# Ejemplos PowerShell en Readme.md. ASP.NET no carga este archivo automáticamente.
ConnectionStrings__Solvex=Server=.\SQLEXPRESS;Database=Solvex;Integrated Security=True;TrustServerCertificate=True
Cors__AllowedOrigins__0=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
# Solo para pruebas SQL reales sobre una base de desarrollo ya migrada; no usar producción.
SOLVEX_SQL_TEST_CONNECTION=Server=.\SQLEXPRESS;Database=SolvexHu01Demo;Integrated Security=True;TrustServerCertificate=True
# Para los recorridos HTTP opcionales; requieren API iniciada.
SOLVEX_TEST_API_URL=http://localhost:5080/api
