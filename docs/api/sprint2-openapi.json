{
  "openapi": "3.0.1",
  "info": {
    "title": "Solvex.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/availability": {
      "post": {
        "tags": [
          "Availability"
        ],
        "summary": "Verifica entre 1 y 100 productos distintos sin reservar ni modificar stock. Los inactivos no se consideran disponibles.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityInput"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityInput"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Consulta existencias de todos los productos, incluidos inactivos.",
