                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PurchaseSummaryDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Purchases"
        ],
        "summary": "Registra una compra Pending con 1–100 productos activos distintos. El servidor calcula importes; no modifica stock.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseInput"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseInput"
              }
            },
            "application/*+json": {
