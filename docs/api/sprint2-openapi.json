              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Registra Entry o Exit y actualiza el saldo atómicamente. No admite productos inactivos ni saldo negativo.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovementInput"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MovementInput"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MovementInput"
              }
            }
          }
        },
