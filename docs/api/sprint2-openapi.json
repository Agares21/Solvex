  "components": {
    "schemas": {
      "AdjustmentDto": {
        "type": "object",
        "properties": {
          "movement": {
            "$ref": "#/components/schemas/MovementDto"
          },
          "currentStock": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AvailabilityDto": {
        "type": "object",
        "properties": {
          "allAvailable": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityItemDto"
            }
          }
        },
        "additionalProperties": false
      },
      "AvailabilityInput": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityItemInput"
            }
          }
        },
        "additionalProperties": false
      },
      "AvailabilityItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "requestedQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "availableQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "isSufficient": {
            "type": "boolean"
          },
          "missingQuantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AvailabilityItemInput": {
        "required": [
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "MovementDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "$ref": "#/components/schemas/MovementType"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "reason": {
            "type": "string"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "MovementInput": {
        "required": [
          "quantity",
          "reason",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/MovementType"
          },
          "quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "reason": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MovementType": {
        "enum": [
          "Entry",
          "Exit"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ProductInput": {
        "required": [
          "code",
          "name",
          "price"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string"
          },
