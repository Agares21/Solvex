    },
    "/api/inventory/{productId}/movements": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Consulta los últimos 50 movimientos del producto, primero los más recientes.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
